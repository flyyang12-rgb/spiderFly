# SpiderFly 默认即可在一台常开 Windows 主机上运行。
# 复制本文件为 .env 后再按需修改；不要提交包含密钥的 .env。

# 服务监听。0.0.0.0 允许局域网访问；浏览器中请填写主机实际 IP，而不是 0.0.0.0。
SPIDERFLY_HOST=0.0.0.0
SPIDERFLY_PORT=8000

# 数据、上传应用和每应用独立虚拟环境的保存位置。
# 相对路径以 spiderFly 项目目录为基准。
# 修改数据目录时，请同时更新应用目录和环境目录。
# 已有任务保存绝对路径；改这些配置不会迁移数据库记录，换电脑请先阅读使用说明。
SPIDERFLY_DATA_DIR=data
SPIDERFLY_APPS_DIR=data/apps
SPIDERFLY_ENVS_DIR=data/envs

# 每次任务共用的唯一工作文件夹。系统会在运行前和运行后清空它。
# 可以改成每台RPA电脑统一使用的绝对路径，例如 C:\RPA公共工作区。
SPIDERFLY_WORK_DIR=共享工作区

# Python 实际运行的全局最长时间，默认 600 秒，支持 60 至 86400 秒；排队不计时。
# 修改后空闲时重启；页面部分位置仍固定显示“10 分钟”，执行以本配置为准。
SPIDERFLY_TASK_TIMEOUT_SECONDS=600
# 宿主机占用检查间隔（秒）。
SPIDERFLY_HOST_CHECK_INTERVAL_SECONDS=2

# SpiderFly 自动化浏览器专用的本机调试端口。普通管理 Chrome 不使用这个端口，不会阻塞任务。
SPIDERFLY_BROWSER_PORT=9123

# 留空时使用启动 SpiderFly 的 Python 来创建各应用虚拟环境。
# 示例：SPIDERFLY_BASE_PYTHON=C:\Program Files\Python313\python.exe
SPIDERFLY_BASE_PYTHON=

# 每应用独立环境的分阶段超时（秒）。
SPIDERFLY_VENV_TIMEOUT_SECONDS=180
SPIDERFLY_PIP_TIMEOUT_SECONDS=1800
SPIDERFLY_ENV_VERIFY_TIMEOUT_SECONDS=60

# 登录会话有效期（小时）。
SPIDERFLY_SESSION_HOURS=12

# 直接通过局域网 HTTP 访问时必须为 false；配置 HTTPS 反向代理后再改为 true。
SPIDERFLY_COOKIE_SECURE=false

# 飞书通知可选；不需要时保持为空。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVER_ID=
FEISHU_RECEIVER_ID_TYPE=open_id
