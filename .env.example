# SpiderFly 不需要 .env 也能按项目默认值运行。
# 只取消注释需要覆盖的本机配置；真实 .env 不得提交到 Git。

# 常用本机覆盖项
# SPIDERFLY_PORT=8000
# SPIDERFLY_WORK_DIR=共享工作区
# SPIDERFLY_TASK_TIMEOUT_SECONDS=600
# SPIDERFLY_BASE_PYTHON=C:\Program Files\Python312\python.exe
# SPIDERFLY_COOKIE_SECURE=false

# 飞书通知（可选；不用时无需创建 .env）
# 群自定义机器人：填写后优先发到群，不再发送给下方个人收件人。
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/替换为自己的地址
# 如开启签名校验，填写机器人安全设置中的签名密钥（不是 App Secret）。
# FEISHU_WEBHOOK_SECRET=
# 如开启关键词校验，可设置关键词 SpiderFly。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVER_ID=
FEISHU_RECEIVER_ID_TYPE=open_id
